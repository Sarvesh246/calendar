# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-cli/
/output/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real values never leave the machine; the example is the contract
.env*
!.env.example

# vercel
.vercel

# claude code local settings
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts
# Skipper — machine-local artifacts (hook scratch + derived index), never commit
.claude/.skipper-*
.skipper/*
!.skipper/receipts/

# editor / AI tooling local state
.cursor/
.playwright-mcp/
graphify-out/
.idea/
.vscode/*
!.vscode/extensions.json
