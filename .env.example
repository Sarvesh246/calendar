# Copy to .env.local. Every variable is optional: with none set, Datebook runs
# fully offline and keeps everything in the browser.

# --- Supabase (accounts + cloud sync) ---
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). The legacy anon key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by the push dispatcher and rate limiting. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI assistant and syllabus import ---
GEMINI_API_KEY=
# GEMINI_MODEL=
# Fallback providers the router tries when Gemini is unavailable.
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=

# --- Closed-app reminders (web push) ---
# Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Shared with the GitHub Actions secret of the same name; authenticates /api/push/dispatch.
CRON_SECRET=

# --- Misc ---
# Canonical origin used in links and OAuth redirects. Defaults to the Vercel URL.
NEXT_PUBLIC_SITE_URL=
# Salt for hashing client IPs in rate limiting.
RATE_LIMIT_SALT=
